# =============================================================================
# FoodieFinds - Environment configuration template
# =============================================================================
# Copy this file to `.env` (and `.env.production` for prod builds) and fill in
# values. NEVER commit a real .env file.
#
# This template was added in response to the Manus repo review which flagged
# hardcoded URLs in `packages/shared/src/constants.ts` and CORS origins in
# `server/index.ts`.

# -----------------------------------------------------------------------------
# Server (server/index.ts, server/index.prod.ts)
# -----------------------------------------------------------------------------

# HTTP port the API listens on. Default: 5000
PORT=5000

# `development` enables Vite dev middleware; `production` serves prebuilt static
NODE_ENV=development

# Comma-separated list of allowed CORS origins (production only).
# Example: https://foodiefinds.com,https://admin.foodiefinds.com
ALLOWED_ORIGINS=https://foodiefinds.com

# Where the public API is reachable from server-to-server callers (workers,
# webhooks, etc.). Used by `packages/shared/src/constants.ts`.
API_BASE_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# Auth (server/auth.ts)
# -----------------------------------------------------------------------------

# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Access token lifetime (e.g. 24h, 15m). Default: 24h
JWT_EXPIRES_IN=24h

# Refresh token lifetime. Default: 7d
REFRESH_TOKEN_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Database (server/db.ts) - PostgreSQL via Drizzle ORM
# -----------------------------------------------------------------------------

# Connection string; required once the in-memory MemStorage is replaced.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/foodiefinds

# -----------------------------------------------------------------------------
# Client / Vite (client/.env)
# -----------------------------------------------------------------------------

# Browser-exposed public API URL. Vite ONLY exposes vars prefixed with VITE_.
# In production this should match the public ingress, e.g. https://api.foodiefinds.com
VITE_API_URL=http://localhost:5000

# Optional: WebSocket endpoint for the realtime updates introduced to replace
# polling (Manus §4.1). Defaults to deriving from VITE_API_URL.
VITE_WS_URL=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# One of: error | warn | info | debug. Default: info
LOG_LEVEL=info
