{
  "name": "foodiefinds-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "FoodieFinds Monorepo - User, Creator, and Admin apps",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.prod.ts",
    "test": "vitest run",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules dist",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=foodiefinds-* && changeset publish",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "turbo:dev": "turbo run dev",
    "turbo:build": "turbo run build"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.5",
    "cookie-parser": "^1.4.6",
    "ws": "^8.18.0",
    "tsx": "^4.19.2",
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.36.0",
    "drizzle-zod": "^0.5.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/express": "^5.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.28.0",
    "postcss": "^8.4.47",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.17",
    "turbo": "^1.12.4",
    "typescript": "^5.3.3",
    "vite": "^5.4.20",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.6.7"
  },
  "packageManager": "npm@9.6.7"
}