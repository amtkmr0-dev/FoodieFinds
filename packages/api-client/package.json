{
    "name": "@foodiefinds/api-client",
    "version": "0.1.0",
    "description": "Type-safe API client for FoodieFinds backend services",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "clean": "rm -rf dist",
        "type-check": "tsc --noEmit"
    },
    "keywords": [
        "foodiefinds",
        "api",
        "client",
        "http",
        "typescript"
    ],
    "author": "FoodieFinds Team",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "dependencies": {
        "@foodiefinds/shared": "file:../shared",
        "@tanstack/react-query": "^5.0.0",
        "axios": "^1.6.0"
    },
    "devDependencies": {
        "@types/node": "^20.11.24",
        "tsup": "^8.0.2",
        "typescript": "^5.3.3"
    },
    "peerDependencies": {
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    }
}